#!/usr/bin/env bash
# Refuse to push a stale bundle. Rebuilds the view AND the installer (which
# embeds the view's bundle) and compares against HEAD, so an edited plugin.js
# whose bundles were never rebuilt/committed can't reach GitHub — the committed
# dist files are the only installable forms.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ ! -x sdk/node_modules/.bin/esbuild ]; then
  echo "pre-push: esbuild not linked (run ./setup.sh) — skipping dist freshness check" >&2
  exit 0
fi
./build.sh . >/dev/null
node installer/build.mjs >/dev/null
if ! git diff --quiet HEAD -- dist/plugin.js installer/dist/plugin.js; then
  echo "pre-push: dist bundles do not match the committed source." >&2
  echo "  Rebuild and commit:  ./build.sh . && node installer/build.mjs \\" >&2
  echo "                       && git add dist/plugin.js installer/dist/plugin.js" >&2
  echo "  (If plugin.js has uncommitted edits, commit or stash them first.)" >&2
  exit 1
fi
