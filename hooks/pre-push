#!/usr/bin/env bash
# Refuse to push stale bundles. Rebuilds the collection code and the global plugin
# and compares against HEAD, so edited source whose bundles were never
# rebuilt/committed can't reach GitHub — the committed dist files are the only
# installable form.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [ ! -x sdk/node_modules/.bin/esbuild ]; then
  echo "pre-push: esbuild not linked (run ./setup.sh) — skipping dist freshness check" >&2
  exit 0
fi
node collection/build.mjs >/dev/null
./build.sh global >/dev/null
if ! git diff --quiet HEAD -- collection/dist/plugin.js global/dist/plugin.js; then
  echo "pre-push: a dist bundle does not match the committed source." >&2
  echo "  Rebuild and commit:  node collection/build.mjs && ./build.sh global && git add collection/dist/plugin.js global/dist/plugin.js" >&2
  echo "  (If the source has uncommitted edits, commit or stash them first.)" >&2
  exit 1
fi
